{
  "expo": {
    "name": "InnerBloom",
    "slug": "innerbloom-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "innerbloom",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.innerbloom.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8705A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.innerbloom.app",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF0EB",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InnerBloom uses your photos so you can set a profile picture.",
          "cameraPermission": "InnerBloom uses your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#994531"
        }
      ],
      "expo-localization",
      "expo-asset",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88730bb9-fd65-4789-a5eb-81105aeeb024"
      }
    }
  }
}
